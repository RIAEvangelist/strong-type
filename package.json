{
  "name": "strong-type",
  "version": "2.0.0",
  "type": "module",
  "description": "Dependency-free native ESM type enforcement for JavaScript values, objects, classes, browsers, and Node.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./node": "./node.js",
    "./node.js": "./node.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "node.js",
    "assets/strong-type-header.png",
    "README.md",
    "licence"
  ],
  "sideEffects": false,
  "directories": {
    "example": "example"
  },
  "engines": {
    "node": ">=12.21.0"
  },
  "scripts": {
    "test": "node test/CI.js && node test/node.js && node test/docs.js",
    "test:core": "node test/CI.js",
    "test:node": "node test/node.js",
    "test:docs": "node test/docs.js",
    "start": "node scripts/serve.js",
    "nodeExample": "node ./example/node/typecheck.js",
    "check": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RIAEvangelist/strong-type.git"
  },
  "keywords": [
    "strong",
    "type",
    "validation",
    "validate",
    "check",
    "checking",
    "esm",
    "isomorphic",
    "browser",
    "node"
  ],
  "author": "Roshi _ _",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RIAEvangelist/strong-type/issues"
  },
  "homepage": "https://riaevangelist.github.io/strong-type/"
}
